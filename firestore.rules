// Firestore security rules for the live field-reporting features.
// Paste this into Firebase console > Firestore Database > Rules > Publish
// (see the setup steps at the top of src/firebaseConfig.ts).
//
// Same casual-privacy philosophy as the site's passcode gate (see
// src/passcode.ts): this keeps the data tidy and on-shape, not locked down
// against a determined bad actor. Nothing here is more sensitive than a
// rough GPS point that already expires in a few hours. In particular, the
// app's "only the reporter or an admin can edit/delete" rule is enforced in
// the UI only (reporterId is a client-generated id, trivially spoofable) —
// there's no real login anywhere in this app to check it against here.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /woundedDeer/{reportId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['latitude', 'longitude', 'note', 'reporterId', 'createdAt', 'expiresAt', 'foundAt'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.reporterId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.foundAt == null
        && (!('note' in request.resource.data)
            || request.resource.data.note == null
            || (request.resource.data.note is string && request.resource.data.note.size() <= 280));

      // Covers both "mark found" (foundAt null -> timestamp) and an admin
      // edit of the position/note — never createdAt/expiresAt/reporterId.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latitude', 'longitude', 'note', 'foundAt'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && (request.resource.data.foundAt == null || request.resource.data.foundAt is timestamp)
        && (!('note' in request.resource.data)
            || request.resource.data.note == null
            || (request.resource.data.note is string && request.resource.data.note.size() <= 280));

      // Anyone can remove a report outright (e.g. placed by mistake, or the
      // animal was recovered) — the UI restricts this to the reporter or an
      // admin, but that's a client-side convenience, not enforced here.
      // Optionally also set a Firestore TTL policy on `expiresAt` in the
      // console so old documents get cleaned up for real after a while —
      // purely housekeeping, not required for the map to behave correctly.
      allow delete: if true;
    }

    match /warnings/{warningId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['latitude', 'longitude', 'note', 'reporterId', 'createdAt', 'resolvedAt'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.reporterId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.resolvedAt == null
        && (!('note' in request.resource.data)
            || request.resource.data.note == null
            || (request.resource.data.note is string && request.resource.data.note.size() <= 280));

      // Only "mark resolved" (resolvedAt null -> timestamp, or back to null
      // to un-resolve) — never the position/note/reporterId/createdAt.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvedAt'])
        && (request.resource.data.resolvedAt == null || request.resource.data.resolvedAt is timestamp);

      // Same casual model as woundedDeer: the UI restricts this to the
      // reporter or an admin, not enforced here.
      allow delete: if true;

      match /comments/{commentId} {
        allow read: if true;
        // Append-only log — no edits or deletes, so "what was said" can't be rewritten after the fact.
        allow create: if request.resource.data.keys().hasOnly(['text', 'authorId', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.authorId is string
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }
  }
}
